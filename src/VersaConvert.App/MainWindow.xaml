<Window x:Class="VersaConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:VersaConvert.Core.Models;assembly=VersaConvert.Core"
        mc:Ignorable="d"
        Title="VersaConvert"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FormatPickerTrigger" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0E1628" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#172238" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#53698F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#A99AFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#172238" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#7564CC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PickerBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#202C43" />
            <Setter Property="Foreground" Value="#DCE4F2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#30405D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#3A4A69" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#5C48BC" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueUtilityButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#1D2940" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentBrush}">
                        <Grid>
                            <Path Data="M 13,13 L 27,13 L 33,19 L 33,35 L 13,35 Z M 27,13 L 27,20 L 33,20 M 18,27 L 28,27 M 23,22 L 28,27 L 23,32"
                                  Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="Bold" Text="VersaConvert" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Ogni file, nel formato giusto. In locale." />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ClearButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="16,11" Click="ClearButton_Click" Content="Svuota" AutomationProperties.Name="Svuota la coda" />
                    <Button x:Name="AddFilesButton" Style="{StaticResource PrimaryButton}" Padding="18,11" Click="AddFilesButton_Click" Content="Aggiungi file" ToolTip="Aggiungi file (Ctrl+O)" AutomationProperties.Name="Aggiungi file" AutomationProperties.HelpText="Scorciatoia Ctrl+O" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="File in coda" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ClearCompletedButton"
                                    Style="{StaticResource QueueUtilityButton}"
                                    Margin="0,0,8,0"
                                    Click="ClearCompletedButton_Click"
                                    Content="Rimuovi completati"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Rimuovi i file completati dalla coda"
                                    AutomationProperties.HelpText="Scorciatoia Ctrl+Maiusc+Canc" />
                            <Border Background="#202B44" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock x:Name="FileCountText" FontSize="11" FontWeight="SemiBold" Foreground="#B8C3D8" Text="0 FILE" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView x:Name="JobsList"
                                  ItemsSource="{Binding Jobs}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Margin="10,0,10,10"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Focusable" Value="True" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConversionJob}">
                                    <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="14" Padding="13,11" BorderBrush="#22304B" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="106" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9" Background="#2A3560" VerticalAlignment="Top">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#C9C0FF" Text="{Binding ExtensionDisplay}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="3,0,14,0">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" ToolTip="{Binding InputPath}" />
                                                <TextBlock Margin="0,4,0,7" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SizeDisplay}" />
                                                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" AutomationProperties.Name="Avanzamento file" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Text="{Binding StatusDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B9C4D8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:JobStatus.Completed}">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:JobStatus.Failed}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:JobStatus.Converting}">
                                                                    <Setter Property="Foreground" Value="#A99AFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="115" Text="{Binding Message}" ToolTip="{Binding Message}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Width="30" Height="30" Margin="0,0,4,0" Padding="7" Tag="{Binding}" Click="OpenJobOutputButton_Click" ToolTip="Mostra il file convertito" AutomationProperties.Name="Mostra il file convertito">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOutput}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Width="14" Height="14" Data="M 2,5 L 6,5 L 7.5,7 L 14,7 L 14,13 L 2,13 Z M 9,2 L 14,2 L 14,5 M 14,2 L 8,8" Stroke="#DCE4F2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Button>
                                                <Button Width="30" Height="30" Margin="0,0,4,0" Padding="7" Tag="{Binding}" Click="RetryJobButton_Click" ToolTip="Riprova questo file" AutomationProperties.Name="Riprova questo file">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Width="14" Height="14" Data="M 12.5,5 A 5.5,5.5 0 1 0 13,9 M 12.5,2 L 12.5,5 L 9.5,5" Stroke="#DCE4F2" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Button>
                                                <Button Width="30" Height="30" Style="{StaticResource IconButton}" Padding="7" Tag="{Binding}" Click="RemoveJobButton_Click" ToolTip="Rimuovi dalla coda (Canc)" AutomationProperties.Name="Rimuovi dalla coda">
                                                    <Path Width="12" Height="12" Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#DCE4F2" StrokeThickness="1.7" StrokeStartLineCap="Round" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border x:Name="EmptyState" Margin="20" CornerRadius="16" BorderBrush="#344261" BorderThickness="1" Background="#0E1628">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                <Border Width="70" Height="70" CornerRadius="16" Background="#202B4A" HorizontalAlignment="Center">
                                    <Path Width="30" Height="30" Data="M 15,4 L 15,21 M 8,12 L 15,5 L 22,12 M 5,25 L 25,25" Stroke="#BFB5FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Border>
                                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Trascina qui i tuoi file" />
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource MutedTextBrush}" Text="Video, audio, immagini, testo e documenti. I formati compatibili appariranno automaticamente." />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,18,0,0" Padding="16,9" HorizontalAlignment="Center" Click="AddFilesButton_Click" Content="Sfoglia file" AutomationProperties.Name="Sfoglia file" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DropFeedbackOverlay"
                                Panel.ZIndex="10"
                                Margin="10"
                                Padding="24"
                                Background="#F0182440"
                                BorderBrush="#8D7BFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DropFeedbackScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="68" Height="68" HorizontalAlignment="Center" Background="#493B99" CornerRadius="16">
                                    <Path Width="30"
                                          Height="30"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 15,3 L 15,20 M 8,13 L 15,20 L 22,13 M 5,26 L 25,26"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Border>
                                <TextBlock Margin="0,17,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Rilascia per aggiungere" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="#B8C5DB" Text="Puoi aggiungere più file contemporaneamente" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Impostazioni" />

                            <TextBlock Margin="0,18,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="FORMATO DI USCITA" />
                            <ToggleButton x:Name="FormatPickerButton"
                                          Style="{StaticResource FormatPickerTrigger}"
                                          IsChecked="{Binding IsOpen, ElementName=FormatPickerPopup, Mode=TwoWay}"
                                          PreviewMouseLeftButtonDown="FormatPickerButton_PreviewMouseLeftButtonDown"
                                          PreviewKeyDown="FormatPickerButton_PreviewKeyDown"
                                          AutomationProperties.Name="Scegli il formato di uscita">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="31" HorizontalAlignment="Left" Background="#342B68" CornerRadius="7">
                                        <TextBlock x:Name="SelectedFormatExtensionText"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#D8D1FF"
                                                   Text="—" />
                                    </Border>
                                    <TextBlock x:Name="SelectedFormatNameText"
                                               Grid.Column="1"
                                               Margin="4,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="Nessun formato" />
                                    <Path Grid.Column="2"
                                          Width="9"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0,0 L 4.5,5 L 9,0"
                                          Stroke="#A9B5CA"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </ToggleButton>
                            <TextBlock x:Name="FormatDescriptionText"
                                       Margin="2,7,0,0"
                                       FontSize="10"
                                       LineHeight="15"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Aggiungi un file per vedere i formati compatibili." />

                            <Popup x:Name="FormatPickerPopup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=FormatPickerButton}"
                                   HorizontalOffset="-108"
                                   VerticalOffset="7"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="None"
                                   Opened="FormatPickerPopup_Opened">
                                <Border x:Name="FormatPickerSurface"
                                        Width="405"
                                        MaxHeight="388"
                                        Margin="14"
                                        Padding="16"
                                        Background="#151E31"
                                        CornerRadius="16"
                                        RenderTransformOrigin="0.74,0"
                                        SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="FormatPickerScale" ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="8" Opacity="0.5" Color="#050914" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="2,0,2,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Scegli il formato" />
                                            <TextBlock x:Name="FormatResultCountText"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#A99AFF"
                                                       Text="0 FORMATI" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <TextBox x:Name="FormatSearchTextBox"
                                                     Height="40"
                                                     Padding="34,9,10,9"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="FormatSearchTextBox_TextChanged"
                                                     PreviewKeyDown="FormatSearchTextBox_PreviewKeyDown"
                                                     AutomationProperties.Name="Cerca un formato" />
                                            <Path Width="14"
                                                  Height="14"
                                                  Margin="12,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Data="M 11,11 L 15,15 M 13,7 A 6,6 0 1 1 1,7 A 6,6 0 1 1 13,7"
                                                  Stroke="#8290A8"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" />
                                            <TextBlock x:Name="FormatSearchPlaceholder"
                                                       Margin="34,0,10,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       FontSize="12"
                                                       Foreground="#8290A8"
                                                       Text="Cerca formato…" />
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="FormatOptionsItemsControl">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource FormatChoiceButton}"
                                                                    Tag="{Binding Format}"
                                                                    Content="{Binding DisplayExtension}"
                                                                    ToolTip="{Binding Tooltip}"
                                                                    AutomationProperties.Name="{Binding Tooltip}"
                                                                    MouseEnter="FormatChoiceButton_MouseEnter"
                                                                    MouseLeave="FormatChoiceButton_MouseLeave"
                                                                    Click="FormatOptionButton_Click" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock x:Name="FormatEmptyText"
                                                       Margin="18,28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Nessun formato corrisponde alla ricerca."
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Popup>

                            <StackPanel x:Name="PresetSettingsPanel" Margin="0,17,0,0">
                                <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="PRESET" />
                                <ComboBox x:Name="PresetComboBox"
                                          SelectedIndex="0"
                                          SelectionChanged="PresetComboBox_SelectionChanged"
                                          AutomationProperties.Name="Preset di conversione">
                                    <ComboBoxItem Tag="Balanced" Content="Bilanciato" />
                                    <ComboBoxItem Tag="Maximum" Content="Qualità massima" />
                                    <ComboBoxItem Tag="Compact" Content="Dimensione ridotta" />
                                    <ComboBoxItem Tag="Custom" Content="Personalizzato" />
                                </ComboBox>
                                <TextBlock x:Name="PresetDescriptionText"
                                           Margin="2,6,0,0"
                                           FontSize="10"
                                           LineHeight="15"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Un buon equilibrio tra qualità e dimensione." />
                            </StackPanel>

                            <TextBlock Margin="0,17,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="CARTELLA DI DESTINAZIONE" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" VerticalContentAlignment="Center" TextChanged="OutputDirectoryTextBox_TextChanged" AutomationProperties.Name="Cartella di destinazione" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Padding="9" Click="BrowseOutputButton_Click" ToolTip="Scegli cartella" AutomationProperties.Name="Scegli la cartella di destinazione">
                                    <Path Width="15" Height="13" Data="M 1.5,4 L 6,4 L 7.5,6 L 14.5,6 L 14.5,12 L 1.5,12 Z M 1.5,4 L 1.5,2 L 6,2 L 7.5,4" Stroke="#DCE4F2" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round" />
                                </Button>
                            </Grid>

                            <StackPanel x:Name="QualitySettingsPanel" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="QUALITÀ" />
                                    <TextBlock x:Name="QualityValueText" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#C9C0FF" Text="75%" />
                                </Grid>
                                <Slider x:Name="QualitySlider" Margin="0,6,0,0" Minimum="1" Maximum="100" Value="75" TickFrequency="1" ValueChanged="QualitySlider_ValueChanged" AutomationProperties.Name="Qualità di conversione" />
                            </StackPanel>

                            <StackPanel x:Name="BitrateSettingsPanel" Margin="0,15,0,0">
                                <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="BITRATE AUDIO" />
                                <ComboBox x:Name="BitrateComboBox" SelectedIndex="1" SelectionChanged="BitrateComboBox_SelectionChanged" AutomationProperties.Name="Bitrate audio">
                                    <ComboBoxItem Tag="128" Content="128 kbps — compatto" />
                                    <ComboBoxItem Tag="192" Content="192 kbps — bilanciato" />
                                    <ComboBoxItem Tag="256" Content="256 kbps — alta qualità" />
                                    <ComboBoxItem Tag="320" Content="320 kbps — massimo" />
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Margin="0,15,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="SE IL FILE ESISTE" />
                            <ComboBox x:Name="CollisionComboBox" SelectedIndex="0" SelectionChanged="CollisionComboBox_SelectionChanged" AutomationProperties.Name="Comportamento se il file esiste">
                                <ComboBoxItem Tag="Rename" Content="Crea un nuovo nome" />
                                <ComboBoxItem Tag="Overwrite" Content="Sovrascrivi" />
                                <ComboBoxItem Tag="Skip" Content="Salta" />
                            </ComboBox>

                            <CheckBox x:Name="PreserveMetadataCheckBox" Margin="0,17,0,0" IsChecked="True" Content="Conserva i metadati quando possibile" AutomationProperties.Name="Conserva i metadati" />
                            <CheckBox x:Name="OpenOutputOnCompletionCheckBox" Margin="0,11,0,0" IsChecked="False" Content="Apri la cartella al termine" AutomationProperties.Name="Apri la cartella al termine della conversione" />

                            <Border x:Name="PreflightBorder" Margin="0,18,0,0" Padding="13" CornerRadius="12" Background="#18253A">
                                <StackPanel>
                                    <TextBlock x:Name="PreflightTitleText" FontSize="12" FontWeight="SemiBold" Text="In attesa dei file" />
                                    <TextBlock x:Name="PreflightSummaryText" Margin="0,4,0,0" FontSize="10" LineHeight="15" TextWrapping="Wrap" Foreground="#B8C5DB" Text="Aggiungi almeno un file per preparare la conversione." />
                                    <TextBlock x:Name="PreflightWarningText" Margin="0,6,0,0" FontSize="10" LineHeight="15" TextWrapping="Wrap" Foreground="#FCA5A5" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" CornerRadius="16" Background="#10192B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="MOTORI DI CONVERSIONE" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Text="Audio · video · immagini" />
                                <TextBlock x:Name="FfmpegStatusText" Grid.Column="1" FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Text="Documenti Office" />
                                <TextBlock x:Name="OfficeStatusText" Grid.Column="1" FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#1D2940" BorderThickness="0,1,0,0" Padding="28,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OverallStatusText" FontSize="12" FontWeight="SemiBold" Text="Aggiungi uno o più file per iniziare" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OverallStatusTranslate" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="OverallEtaText" Grid.Column="1" Margin="0,0,14,0" FontSize="11" Foreground="#B8C5DB" Text="" AutomationProperties.Name="Tempo stimato" />
                        <TextBlock x:Name="OverallPercentText" Grid.Column="2" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="0%" />
                    </Grid>
                    <ProgressBar x:Name="OverallProgressBar" Style="{StaticResource ThinProgress}" Margin="0,9,0,0" Height="7" Value="0" AutomationProperties.Name="Avanzamento complessivo" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RetryFailedButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="16,12" Click="RetryFailedButton_Click" Content="Riprova" Visibility="Collapsed" AutomationProperties.Name="Riprova i file non riusciti" />
                    <Button x:Name="OpenOutputButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="16,12" Click="OpenOutputButton_Click" Content="Apri cartella" AutomationProperties.Name="Apri la cartella di destinazione" />
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="16,12" Click="CancelButton_Click" Content="Annulla" Visibility="Collapsed" AutomationProperties.Name="Annulla la conversione" />
                    <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButton}" MinWidth="150" Padding="22,12" Click="ConvertButton_Click" Content="Converti ora" IsEnabled="False" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Avvia la conversione" AutomationProperties.HelpText="Scorciatoia Ctrl+Invio" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
